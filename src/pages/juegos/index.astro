---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaJuego from '../../components/TarjetaJuego.astro';
import Filtros from '../../components/Filtros.astro';
const juegos = (await getCollection('juegos')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base titulo="Juegos y actividades" descripcion="Juegos educativos gratuitos de español, matemáticas y didáctica para primaria, secundaria y docentes. Funcionan en celular y computadora.">
  <div class="envoltura py-10 md:py-16">
    <h1 class="text-5xl font-extrabold md:text-7xl">Juegos y actividades</h1>
    <p class="mt-4 max-w-xl text-xl">Elige uno y practica desde el celular o la computadora. No necesitas cuenta. Si das clases, puedes proyectarlos con tu grupo.</p>
    <Filtros elementos={juegos.map((j) => j.data)} nombre="juegos" />
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {juegos.map((j) => <TarjetaJuego id={j.id} {...j.data} />)}
    </div>
    <p data-sin-resultados hidden class="mt-8 text-xl">Todavía no hay juegos con esa combinación. Prueba con otro nivel o materia.</p>
  </div>
</Base>
