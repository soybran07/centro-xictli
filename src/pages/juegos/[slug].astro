---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Memorama from '../../components/juegos/Memorama.astro';
import Quiz from '../../components/juegos/Quiz.astro';
import Arrastrar from '../../components/juegos/Arrastrar.astro';
import { ruta } from '../../lib/rutas';
import { etiquetaNivel, nombreMateria } from '../../config/catalogo';

export async function getStaticPaths() {
  const juegos = await getCollection('juegos');
  return juegos.map((juego) => ({ params: { slug: juego.id }, props: { juego } }));
}
const { juego } = Astro.props as { juego: CollectionEntry<'juegos'> };
const d = juego.data;
const tema = d.tema ? (await getCollection('temas')).find((t) => t.id === d.tema) : undefined;
---
<Base privado titulo={d.titulo} descripcion={d.descripcion}>
  <div class="envoltura max-w-3xl py-8 md:py-12">
    <a data-volver class="enlace font-bold" href={ruta('/juegos')}>Volver a los juegos</a>
    <div data-modo-tarea hidden class="mt-4 rounded-2xl bg-rosa-claro p-4 text-negro">
      <p class="font-bold">Estás haciendo una tarea.</p>
      <p data-modo-estado role="status">Tu resultado se guardará al terminar. Si lo repites, se queda tu mejor intento.</p>
    </div>
    <h1 class="mt-4 text-4xl font-extrabold md:text-6xl">{d.titulo}</h1>
    <p class="mt-2 font-bold">{nombreMateria(d.materia)} · {etiquetaNivel(d.nivel, d.grados)}</p>
    <p class="mt-4 max-w-[62ch] text-lg">{d.instrucciones}</p>
    {tema && <p class="mt-3 text-lg">¿Necesitas repasar primero? Lee el tema <a class="enlace font-bold" href={ruta(`/temas/${tema.id}`)}>{tema.data.titulo}</a>.</p>}
    <div class="mt-8">
      {d.tipo === 'memorama' && <Memorama pares={d.pares} />}
      {d.tipo === 'quiz' && <Quiz preguntas={d.preguntas} />}
      {d.tipo === 'arrastrar' && <Arrastrar pares={d.pares} />}
    </div>
    <noscript><p class="mt-6 font-bold">Para jugar necesitas activar JavaScript en tu navegador.</p></noscript>
  </div>
</Base>
<script>
  // Modo tarea: si se abrió desde la plataforma (?tarea=ID), guarda el resultado.
  const id = new URLSearchParams(location.search).get('tarea');
  if (id && /^[0-9a-f-]{36}$/i.test(id)) {
    const aviso = document.querySelector<HTMLElement>('[data-modo-tarea]')!;
    const estado = document.querySelector<HTMLElement>('[data-modo-estado]')!;
    const volver = document.querySelector<HTMLAnchorElement>('[data-volver]')!;
    aviso.hidden = false;
    const { ruta } = await import('../../lib/rutas');
    volver.href = `${ruta('/plataforma/tarea')}?id=${id}`;
    volver.textContent = 'Volver a la tarea';
    document.addEventListener('juego:terminado', async (e) => {
      const { puntaje, total, detalle } = (e as CustomEvent<{ puntaje: number; total: number; detalle: string }>).detail;
      estado.textContent = 'Guardando tu resultado…';
      const { plataformaLista } = await import('../../config/plataforma');
      if (!plataformaLista) { estado.textContent = 'La plataforma no está conectada; tu resultado no se guardó.'; return; }
      const { supabase } = await import('../../lib/supabase');
      const sb = supabase();
      const { data: u } = await sb.auth.getUser();
      if (!u.user) { estado.textContent = 'Tu sesión terminó. Inicia sesión de nuevo y vuelve a jugar para guardar.'; return; }
      const { data: previa } = await sb.from('entregas').select('puntaje, total').eq('tarea_id', id).eq('alumno_id', u.user.id).maybeSingle();
      if (previa?.puntaje != null && previa.total && previa.puntaje / previa.total >= puntaje / total) {
        estado.textContent = `Obtuviste ${puntaje} de ${total}. Tu mejor resultado (${previa.puntaje} de ${previa.total}) ya está guardado.`;
        return;
      }
      const { error } = await sb.from('entregas').upsert(
        { tarea_id: id, alumno_id: u.user.id, puntaje, total, detalle: String(detalle).slice(0, 200), completada_en: new Date().toISOString() },
        { onConflict: 'tarea_id,alumno_id' },
      );
      estado.textContent = error ? 'No se pudo guardar tu resultado. Revisa tu conexión y vuelve a intentarlo.' : `¡Resultado guardado! ${puntaje} de ${total} ✓`;
    });
  }
</script>
