---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaJuego from '../../components/TarjetaJuego.astro';
import { ruta } from '../../lib/rutas';
import { etiquetaNivel, nombreCampo, nombreMateria } from '../../config/catalogo';

export async function getStaticPaths() {
  const temas = await getCollection('temas');
  return temas.map((tema) => ({ params: { slug: tema.id }, props: { tema } }));
}
const { tema } = Astro.props as { tema: CollectionEntry<'temas'> };
const d = tema.data;
const { Content } = await render(tema);
const juegos = (await getCollection('juegos', (j) => j.data.tema === tema.id)).sort((a, b) => a.data.orden - b.data.orden);
---
<Base privado titulo={d.titulo} descripcion={d.descripcion}>
  <article class="envoltura max-w-3xl py-8 md:py-12">
    <a class="enlace font-bold" href={ruta('/temas')}>Volver a los temas</a>
    <p class="mt-6 font-bold text-rosa-oscuro dark:text-rosa">{nombreMateria(d.materia)} · {etiquetaNivel(d.nivel, d.grados)}</p>
    <h1 class="mt-2 text-4xl font-extrabold md:text-6xl">{d.titulo}</h1>
    <p class="mt-4 text-xl">{d.descripcion}</p>
    {nombreCampo(d.materia) && d.nivel !== 'docentes' && <p class="mt-2 text-base">Campo formativo: {nombreCampo(d.materia)}</p>}
    <div class="prosa mt-8"><Content /></div>
    {d.fuentes.length > 0 && (
      <section class="mt-12 border-t-2 border-current pt-6" aria-labelledby="fuentes">
        <h2 id="fuentes" class="text-2xl font-bold">Fuentes y para saber más</h2>
        <ul class="mt-3 list-disc space-y-1 pl-6">
          {d.fuentes.map((f) => <li>{f.url ? <a class="enlace" href={f.url} target="_blank" rel="noopener">{f.titulo}</a> : f.titulo}</li>)}
        </ul>
      </section>
    )}
  </article>
  {juegos.length > 0 && (
    <section class="bg-rosa-claro py-12 text-negro" aria-labelledby="practica">
      <div class="envoltura">
        <h2 id="practica" class="text-4xl font-bold">Ahora practica</h2>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {juegos.map((j) => <TarjetaJuego id={j.id} {...j.data} />)}
        </div>
      </div>
    </section>
  )}
</Base>
