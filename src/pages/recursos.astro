---
import Base from '../layouts/Base.astro';
import recursos from '../data/recursos.json';
type Recurso = { titulo: string; descripcion: string; tipo: string; url: string; youtubeId?: string };
const lista = recursos as Recurso[];
---
<Base titulo="Recursos" descripcion="Materiales descargables y videos de Centro Xictli para alumnos, familias y docentes.">
  <div class="envoltura py-10 md:py-16">
    <h1 class="text-5xl font-extrabold md:text-7xl">Recursos</h1>
    <p class="mt-4 max-w-xl text-xl">Materiales para repasar, imprimir o llevar al salón.</p>
    <ul class="mt-10 border-b-2 border-current">
      {lista.map((r) => (
        <li class="grid gap-4 border-t-2 border-current py-6 md:grid-cols-[2fr_1fr] md:items-center">
          <div>
            <h2 class="text-2xl font-bold md:text-3xl">{r.titulo}</h2>
            <p class="mt-2 max-w-[62ch]">{r.descripcion}</p>
            {r.youtubeId && (
              <iframe class="mt-4 aspect-video w-full max-w-xl rounded-lg" loading="lazy" title={`Video: ${r.titulo}`}
                src={`https://www.youtube-nocookie.com/embed/${r.youtubeId}`}
                allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
            )}
          </div>
          <div class="md:text-right">
            {r.url
              ? <a class="boton" href={r.url} target="_blank" rel="noopener">Abrir {r.tipo}<span class="sr-only"> de {r.titulo} (se abre en otra pestaña)</span></a>
              : !r.youtubeId && <p class="font-bold">{r.tipo} disponible pronto</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
