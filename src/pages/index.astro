---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaJuego from '../components/TarjetaJuego.astro';
import TarjetaTema from '../components/TarjetaTema.astro';
import LlamadoContacto from '../components/LlamadoContacto.astro';
import { servicios } from '../data/servicios';
import { ruta } from '../lib/rutas';

const todos = await getCollection('juegos');
const juegos = todos.sort((a, b) => a.data.orden - b.data.orden).slice(0, 3);
const temas = (await getCollection('temas')).sort((a, b) => a.data.orden - b.data.orden).slice(0, 4);
const publicos = [
  { titulo: 'Si eres mamá o papá', texto: 'Sabrás qué se está trabajando y cómo apoyar en casa sin pelear con la tarea.' },
  { titulo: 'Si eres alumno', texto: 'Practicas con juegos y vuelves a intentar las veces que necesites.' },
  { titulo: 'Si das clases', texto: 'Encuentras actividades listas para proyectar o compartir con tu grupo.' },
];
---
<Base>
  <section class="bg-rosa text-negro">
    <div class="envoltura grid items-center gap-10 pt-10 pb-8 md:grid-cols-[1.3fr_1fr] md:pt-16">
      <div>
        <h1 class="text-[clamp(3rem,10vw,6.25rem)] font-extrabold">Clases que se entienden, juegos que enseñan.</h1>
        <p class="mt-6 max-w-xl text-xl">Xictli es un centro de pedagogía, regularización y apoyo para dar clases, donde la educación y el software trabajan juntos.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="boton boton-negro" href={ruta('/juegos')}>Ver los juegos</a>
          <a class="boton boton-borde !text-negro !ring-negro hover:!text-blanco" href={ruta('/servicios')}>Ver servicios</a>
        </div>
      </div>
      <div id="reto" class="rounded-2xl bg-blanco p-6 text-negro">
        <h2 class="text-xl font-bold">Prueba ahora</h2>
        <p class="mt-3 font-titulo text-6xl font-extrabold" id="reto-pregunta">7 × 8</p>
        <div class="mt-5 grid grid-cols-3 gap-2">
          {[54, 56, 63].map((n) => (
            <button type="button" data-valor={n} class="reto-opcion min-h-14 cursor-pointer rounded-lg font-titulo text-2xl font-bold ring-2 ring-negro ring-inset hover:bg-rosa-claro">{n}</button>
          ))}
        </div>
        <p id="reto-mensaje" role="status" class="mt-4 min-h-14">Elige un resultado.</p>
      </div>
    </div>
    <svg aria-hidden="true" viewBox="0 0 1440 90" preserveAspectRatio="none" class="block h-12 w-full fill-blanco md:h-20 dark:fill-negro"><path d="M0 90V34Q360-26 720 62 1080-26 1440 34V90Z"/></svg>
  </section>

  <section class="envoltura grid gap-6 py-14 md:grid-cols-[1fr_2fr] md:py-20">
    <h2 class="text-4xl font-bold md:text-5xl">Qué es Xictli</h2>
    <div class="max-w-[62ch] space-y-4 text-xl">
      <p>En náhuatl, <span lang="nah">xictli</span> significa ombligo: el centro de donde parte todo. Por eso ponemos en el centro a quien aprende.</p>
      <p>Unimos lo que sabemos de pedagogía con herramientas digitales hechas a la medida: juegos para practicar, materiales para repasar y actividades que se pueden usar en casa o en el salón.</p>
    </div>
  </section>

  <section class="envoltura pb-14 md:pb-20" aria-labelledby="servicios">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="servicios" class="text-4xl font-bold md:text-5xl">En qué te ayudamos</h2>
      <a class="enlace font-bold" href={ruta('/servicios')}>Ver servicios por nivel</a>
    </div>
    <dl class="mt-8 border-b-2 border-current">
      {servicios.map((s) => (
        <div class="grid gap-2 border-t-2 border-current py-6 md:grid-cols-[1fr_2fr]">
          <dt class="font-titulo text-3xl font-bold">{s.titulo}</dt>
          <dd class="max-w-[62ch] text-lg">{s.texto}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-rosa-claro py-14 text-negro md:py-20">
    <div class="envoltura grid gap-8 md:grid-cols-3">
      {publicos.map((p) => (
        <div>
          <h2 class="text-3xl font-bold">{p.titulo}</h2>
          <p class="mt-3 text-lg">{p.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="envoltura py-14 md:py-20" aria-labelledby="juegos">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="juegos" class="text-4xl font-bold md:text-5xl">Para jugar hoy</h2>
      <a class="enlace font-bold" href={ruta('/juegos')}>Ver todos los juegos</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {juegos.map((j) => <TarjetaJuego id={j.id} {...j.data} />)}
    </div>
  </section>

  <section class="envoltura pb-14 md:pb-20" aria-labelledby="temas">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="temas" class="text-4xl font-bold md:text-5xl">Para entender antes de practicar</h2>
      <a class="enlace font-bold" href={ruta('/temas')}>Ver todos los temas</a>
    </div>
    <div class="mt-6 grid gap-x-10 border-b-2 border-current md:grid-cols-2">
      {temas.map((t) => <TarjetaTema id={t.id} {...t.data} juegos={todos.filter((j) => j.data.tema === t.id).length} />)}
    </div>
  </section>

  <LlamadoContacto />
</Base>
<script>
  const mensaje = document.getElementById('reto-mensaje')!;
  document.querySelectorAll<HTMLButtonElement>('.reto-opcion').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.reto-opcion').forEach((o) => o.classList.remove('bg-rosa', 'bg-negro', 'text-blanco'));
      if (b.dataset.valor === '56') {
        b.classList.add('bg-rosa');
        mensaje.textContent = '¡Correcto! Siete por ocho son 56. Hay más en el memorama de tablas.';
      } else {
        b.classList.add('bg-negro', 'text-blanco');
        mensaje.textContent = `${b.dataset.valor} no es. Intenta con otro: 7 × 7 son 49, súmale un 7 más.`;
      }
    });
  });
</script>
