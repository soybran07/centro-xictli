---
import '../styles/global.css';
import { sitio } from '../config/sitio';
import { ruta } from '../lib/rutas';

// privado: páginas para alumnos (plataforma, juegos, temas). No aparecen en buscadores.
interface Props { titulo?: string; descripcion?: string; privado?: boolean; }
const { titulo, descripcion = sitio.descripcion, privado = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${sitio.nombre}` : `${sitio.nombre}: pedagogía, regularización y software educativo`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ruta('/img/og.png'), Astro.site);
const actual = Astro.url.pathname.replace(/\/$/, '');
// Al público solo se le muestran Inicio e Iniciar sesión. Todo lo demás
// (juegos, temas, tareas) vive dentro de la plataforma de alumnos.
const navegacion = [
  { texto: 'Inicio', href: ruta('/') },
  { texto: 'Iniciar sesión', href: ruta('/entrar') },
];
const esActual = (href: string) => {
  const limpio = href.replace(/\/$/, '');
  return limpio === ruta('/').replace(/\/$/, '') ? actual === limpio : actual.startsWith(limpio);
};
const whatsapp = sitio.whatsapp ? `https://wa.me/${sitio.whatsapp}` : '';
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {privado && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/png" href={ruta('/favicon.png')} />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content="Logo de Xictli: dos colibríes sobre un libro abierto" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var tema = null;
        try { tema = localStorage.getItem('tema'); } catch (e) {}
        if (tema === 'oscuro') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-blanco focus:p-3 focus:text-negro">Saltar al contenido</a>
    <header class="envoltura flex items-center justify-between gap-2 py-3">
      <a href={ruta('/')} class="shrink-0" aria-label="Centro Xictli, ir al inicio">
        <img src={ruta('/img/logo-claro.png')} alt="" width="56" height="56" class="h-14 w-auto dark:hidden" />
        <img src={ruta('/img/logo-oscuro.png')} alt="" width="56" height="56" class="hidden h-14 w-auto dark:block" />
      </a>
      <div class="flex items-center gap-1 sm:gap-2">
        <nav aria-label="Principal">
          <ul class="flex items-center">
            {navegacion.map((n, i) => (
              <li>
                <a href={n.href} data-enlace-entrar={n.href === ruta('/entrar') ? '' : undefined} aria-current={esActual(n.href) ? 'page' : undefined}
                  class:list={i === navegacion.length - 1
                    ? ['ml-1 inline-flex min-h-11 items-center rounded-full bg-negro px-4 font-bold text-blanco hover:bg-rosa hover:text-negro dark:bg-blanco dark:text-negro dark:hover:bg-rosa']
                    : ['inline-flex min-h-11 items-center px-2 font-bold sm:px-3 hover:underline underline-offset-4', esActual(n.href) && 'underline decoration-rosa decoration-[3px]']}>{n.texto}</a>
              </li>
            ))}
          </ul>
        </nav>
        <button id="tema" type="button" aria-pressed="false" aria-label="Modo oscuro" class="grid size-11 cursor-pointer place-items-center rounded-full hover:bg-rosa-claro dark:hover:bg-rosa dark:hover:text-negro">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current"><path d="M12 2a10 10 0 1 0 0 20V2Z"/><path fill-rule="evenodd" d="M12 2a10 10 0 0 1 0 20 10 10 0 0 1 0-20Zm0 2a8 8 0 0 0 0 16 8 8 0 0 0 0-16Z"/></svg>
        </button>
      </div>
    </header>

    <main id="contenido" class="flex-1"><slot /></main>

    <footer class="bg-negro text-blanco dark:border-t dark:border-blanco/30">
      <div class="envoltura flex flex-col gap-6 py-10 sm:flex-row sm:justify-between">
        <div>
          <p class="font-titulo text-2xl font-bold">{sitio.nombre}</p>
          <p class="mt-1 max-w-sm">La educación y el software, en el mismo lugar.</p>
          {sitio.ubicacion && <p class="mt-2">{sitio.ubicacion}</p>}
        </div>
        <ul class="space-y-1">
          {sitio.telefono && <li><a class="underline underline-offset-4" href={`tel:${sitio.telefono.replace(/\s/g, '')}`}>{sitio.telefono}</a></li>}
          {whatsapp && <li><a class="underline underline-offset-4" href={whatsapp}>Escríbenos por WhatsApp</a></li>}
          {sitio.correo && <li><a class="underline underline-offset-4" href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>}
          {sitio.formularioUrl && <li><a class="underline underline-offset-4" href={sitio.formularioUrl}>Pedir informes</a></li>}
          <li><a class="underline underline-offset-4" href={ruta('/entrar')} data-enlace-entrar>Iniciar sesión</a></li>
          <li><a class="underline underline-offset-4" href={ruta('/contacto')}>Contacto</a></li>
          <li><a class="underline underline-offset-4" href={ruta('/aviso-de-privacidad')}>Aviso de privacidad</a></li>
        </ul>
      </div>
      <div class="envoltura border-t border-blanco/30 py-5 text-base">
        <p>© 2027 {sitio.nombre}. Todos los derechos reservados. · <a class="underline underline-offset-4" href={ruta('/aviso-de-privacidad')}>Aviso de privacidad</a></p>
      </div>
    </footer>

    <script>
      // Si ya hay una sesión guardada, "Iniciar sesión" se vuelve "Mi plataforma".
      // Es solo un atajo visual: la sesión real la valida cada página de la plataforma.
      try {
        if (localStorage.getItem('xictli-sesion')) {
          const destino = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/plataforma`;
          document.querySelectorAll<HTMLAnchorElement>('[data-enlace-entrar]').forEach((a) => {
            a.textContent = 'Mi plataforma';
            a.href = destino;
            a.removeAttribute('aria-current');
          });
        }
      } catch {}

      const boton = document.getElementById('tema')!;
      const raiz = document.documentElement;
      const pintar = () => boton.setAttribute('aria-pressed', String(raiz.classList.contains('dark')));
      pintar();
      boton.addEventListener('click', () => {
        raiz.classList.toggle('dark');
        pintar();
        try { localStorage.setItem('tema', raiz.classList.contains('dark') ? 'oscuro' : 'claro'); } catch {}
      });
    </script>
  </body>
</html>
