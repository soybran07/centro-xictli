---
import { ruta } from '../lib/rutas';
import { etiquetaNivel, nombreMateria, tiposJuego } from '../config/catalogo';
interface Props { id: string; titulo: string; descripcion: string; materia: string; nivel: string; grados?: string; tipo: 'memorama' | 'quiz' | 'arrastrar'; }
const { id, titulo, descripcion, materia, nivel, grados, tipo } = Astro.props;
const estilos = {
  memorama: 'bg-rosa text-negro',
  quiz: 'bg-negro text-blanco dark:ring-2 dark:ring-blanco dark:ring-inset',
  arrastrar: 'bg-blanco text-negro ring-2 ring-negro ring-inset dark:bg-rosa-claro',
};
---
<article data-filtrable data-nivel={nivel} data-materia={materia} class:list={['relative flex flex-col gap-4 rounded-2xl p-6', estilos[tipo]]}>
  <svg aria-hidden="true" viewBox="0 0 96 64" class="h-16 w-24 fill-current">
    {tipo === 'memorama' && <>
      <rect x="0" y="0" width="28" height="28" rx="5"/><rect x="34" y="0" width="28" height="28" rx="5" opacity=".35"/><rect x="68" y="0" width="28" height="28" rx="5"/>
      <rect x="0" y="36" width="28" height="28" rx="5" opacity=".35"/><rect x="34" y="36" width="28" height="28" rx="5"/><rect x="68" y="36" width="28" height="28" rx="5" opacity=".35"/>
    </>}
    {tipo === 'quiz' && <>
      <circle cx="9" cy="10" r="8"/><rect x="26" y="5" width="70" height="10" rx="5"/>
      <circle cx="9" cy="32" r="8" class="text-rosa" fill="currentColor"/><rect x="26" y="27" width="56" height="10" rx="5" class="text-rosa" fill="currentColor"/>
      <circle cx="9" cy="54" r="8"/><rect x="26" y="49" width="64" height="10" rx="5"/>
    </>}
    {tipo === 'arrastrar' && <>
      <rect x="0" y="2" width="34" height="16" rx="8"/><rect x="0" y="46" width="34" height="16" rx="8"/>
      <rect x="62" y="2" width="34" height="16" rx="3" opacity=".35"/><rect x="62" y="46" width="34" height="16" rx="3" opacity=".35"/>
      <path d="M34 10 62 54M34 54 62 10" stroke="currentColor" stroke-width="3" fill="none"/>
    </>}
  </svg>
  <div class="flex-1">
    <h3 class="text-2xl font-bold">
      <a href={ruta(`/juegos/${id}`)} class="after:absolute after:inset-0 after:rounded-2xl hover:underline underline-offset-4">{titulo}</a>
    </h3>
    <p class="mt-2">{descripcion}</p>
  </div>
  <p class="text-base font-bold">{tiposJuego[tipo]} de {nombreMateria(materia)}<span class="block font-normal">{etiquetaNivel(nivel, grados)}</span></p>
</article>
